fn vector_magnitude(vector) {
    let xsq = vector.x*vector.x;
    let ysq = vector.y*vector.y;
    return math.sqrt(xsq + ysq);
}

fn vector_normalize(vector) {
    let mag = vector_magnitude(vector);
    let vbobj = new_vector(vector.x / mag, vector.y / mag);

    return vbobj;
}

fn vector_dot(vA, vB) {
    return vA.x*vB.x + vA.y*vB.y;
}

fn print_vector(vec) {
    let vec_length = vec:length();
    print("<vector [at=(", vec.x, ",", vec.y, "), length=(", vec_length, ")>");
    return vec;
}

fn new_vector(x, y) {
    let vector_obj = {
        x = x,
        y = y,
        length = vector_magnitude,
        normalize = vector_normalize,
        dot = vector_dot,
        show = print_vector,
    };

    return vector_obj;
}

let base_vector = new_vector(91, 32);
let perp_vector = new_vector(236, 173);
let direction_similarity = perp_vector:normalize():dot(base_vector:normalize()) * 100;

print("Similarity %:", direction_similarity);
